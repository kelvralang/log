const log = @import("github.com/kelvralang/log")
if (log.DEBUG != 10i64 || log.INFO != 20i64 || log.WARN != 30i64 || log.ERROR != 40i64) error("log level constants")
if (!log.isValidLevel(log.DEBUG) || !log.isValidLevel(log.ERROR)) error("known levels must be valid")
if (log.isValidLevel(15i64)) error("unknown levels must be invalid")
if (log.levelName(log.DEBUG) != "DEBUG" || log.levelName(log.WARN) != "WARN") error("log level names")
if (log.levelName(15i64) != "UNKNOWN") error("unknown log level name")
log.setMinimumLevel(log.WARN)
if (log.minimumLevel() != log.WARN) error("log minimum level")
if (log.trySetMinimumLevel(15i64)) error("invalid level update must fail")
if (log.minimumLevel() != log.WARN) error("invalid level update must preserve configuration")
if (log.enabled(log.INFO) || !log.enabled(log.ERROR)) error("minimum-level filtering")
log.warn("test warning")
log.write(log.ERROR, "test error")
log.writeNamed(log.WARN, "package-test", "named warning")
log.setMinimumLevel(log.DEBUG)
if (log.minimumLevel() != log.DEBUG) error("log level update")
log.debugNamed("package-test", "named debug")
